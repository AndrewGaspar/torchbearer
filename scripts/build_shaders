#!/usr/bin/env bash
# Dev-time: compile the mod's own precompiled shaders with a current DXC and embed the DXIL as C
# headers (src/features/rt/shaders/*_dxil.h, committed). Only needed when a .hlsl/.hlsli there
# changes. DXC: build/tools/dxc/bin/dxc, Microsoft's DirectXShaderCompiler Linux release v1.9.2609
# (`gh release download v1.9.2609 -R microsoft/DirectXShaderCompiler -p 'linux_dxc_*.tar.gz'`,
# unpacked into build/tools/dxc; not shipped, only its output is), or $DXC.
# `-validator-version 1.5` is required: DXC 1.9's default (1.8) metadata renders nothing under the
# vkd3d-proton the game runs on (docs/raytracing.md section 11).
set -euo pipefail
cd "$(dirname "$0")/.."
DXC=${DXC:-build/tools/dxc/bin/dxc}
out=build/shaders
sd=src/features/rt/shaders
mkdir -p "$out"
flags=(-O3 -validator-version 1.5 -I "$sd")
"$DXC" -T ps_6_0 -E main -D TB_SHADOW_PCF "${flags[@]}" -Fo "$out/spot_pcf.dxil" "$sd/spotlight.hlsl"
"$DXC" -T ps_6_5 -E main -D TB_SHADOW_RQ "${flags[@]}" -Fo "$out/spot_rq.dxil" "$sd/spotlight.hlsl"
"$DXC" -T ps_6_0 -E main -D TB_SHADOW_NONE "${flags[@]}" -Fo "$out/spot_none.dxil" "$sd/spotlight.hlsl"
cs=(cs_gather cs_ao cs_sun cs_val cs_temporal cs_atrous)
for e in "${cs[@]}"; do
  "$DXC" -T cs_6_5 -E "$e" "${flags[@]}" -Fo "$out/$e.dxil" "$sd/rays.hlsl"
done
ver=$("$DXC" --version | head -1)
python3 - "$ver" "$out" "${cs[@]}" <<'EOF'
import sys
ver, out, cs = sys.argv[1], sys.argv[2], sys.argv[3:]
def arr(name, path):
    b = open(path, "rb").read()
    lines = [", ".join(f"0x{x:02x}" for x in b[i:i + 20]) for i in range(0, len(b), 20)]
    return f"static const unsigned char {name}[{len(b)}] = {{\n  " + ",\n  ".join(lines) + "\n};\n"
sd = "src/features/rt/shaders"
with open(f"{sd}/spotlight_dxil.h", "w") as f:
    f.write("// Generated by scripts/build_shaders from spotlight.hlsl (" + ver + "). Do not edit.\n#pragma once\n")
    f.write(arr("kSpotPcfDxil", f"{out}/spot_pcf.dxil"))
    f.write(arr("kSpotRqDxil", f"{out}/spot_rq.dxil"))
    f.write(arr("kSpotNoneDxil", f"{out}/spot_none.dxil"))
    src = open(f"{sd}/spotlight.hlsl").read()
    f.write('static const char kSpotHlsl[] = R"TBHLSL(' + src + ')TBHLSL";\n')
with open(f"{sd}/rays_dxil.h", "w") as f:
    f.write("// Generated by scripts/build_shaders from rays.hlsl (" + ver + "). Do not edit.\n#pragma once\n")
    for e in cs:
        f.write(arr("k" + "".join(w.capitalize() for w in e.split("_")) + "Dxil", f"{out}/{e}.dxil"))
EOF
echo "wrote $sd/spotlight_dxil.h $sd/rays_dxil.h"
