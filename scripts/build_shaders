#!/usr/bin/env bash
# Dev-time: compile the mod's own precompiled shaders with a current DXC and embed the DXIL as C
# headers (src/features/rt/shaders/*_dxil.h, committed). Only needed when a .hlsl here changes.
# DXC: build/tools/dxc/bin/dxc (Microsoft's DirectXShaderCompiler Linux release, v1.9.2609; not
# shipped, only its output is), or $DXC.
set -euo pipefail
cd "$(dirname "$0")/.."
DXC=${DXC:-build/tools/dxc/bin/dxc}
out=build/shaders
mkdir -p "$out"
hdr=src/features/rt/shaders/spotlight_dxil.h
"$DXC" -T ps_6_0 -E main -D TB_SHADOW_PCF -O3 -Fo "$out/spot_pcf.dxil" src/features/rt/shaders/spotlight.hlsl
"$DXC" -T ps_6_5 -E main -D TB_SHADOW_RQ -O3 -Fo "$out/spot_rq.dxil" src/features/rt/shaders/spotlight.hlsl
python3 - "$hdr" "$out/spot_pcf.dxil" "$out/spot_rq.dxil" "$("$DXC" --version | head -1)" <<'EOF'
import sys
hdr, pcf, rq, ver = sys.argv[1:5]
def arr(name, path):
    b = open(path, "rb").read()
    lines = [", ".join(f"0x{x:02x}" for x in b[i:i + 20]) for i in range(0, len(b), 20)]
    return f"static const unsigned char {name}[{len(b)}] = {{\n  " + ",\n  ".join(lines) + "\n};\n"
with open(hdr, "w") as f:
    f.write("// Generated by scripts/build_shaders from spotlight.hlsl (" + ver + "). Do not edit.\n#pragma once\n")
    f.write(arr("kSpotPcfDxil", pcf))
    f.write(arr("kSpotRqDxil", rq))
EOF
echo "wrote $hdr"
